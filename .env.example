# Copy this file to .env and fill in real values. Never commit .env.

# Required: HMAC signing key for JWTs, 32+ characters. Unset -> the app runs with a random
# ephemeral key that changes on every restart (every session gets invalidated on redeploy).
# Generate one with:
#   openssl rand -base64 48
LASFORM_JWT_SECRET=

# Name of the single organization created on first run.
LASFORM_ORG_NAME=Lasform

# Optional: bootstrap the initial SUPER_ADMIN via env vars on first boot (only takes effect while
# the database has zero users, and only if BOTH are set). Leave both blank to use the in-app
# /setup wizard instead - visit the app once it's running and a fresh install lands you there
# automatically to create the admin account through the UI.
LASFORM_ADMIN_EMAIL=
LASFORM_ADMIN_PASSWORD=

# Optional one-time seeds for admin-editable settings (Settings -> Map Provider / Features in the
# app once logged in). Leave blank and configure later through the UI instead - nothing at startup
# requires these.
GOOGLE_MAPS_API_KEY=
GOOGLE_SSO_CLIENT_ID=

# Host port the app is published on.
APP_PORT=8078

# JVM heap sizing - see DOCKER.md's resource footprint section before changing.
JAVA_OPTS=-Xms256m -Xmx768m
